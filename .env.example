# Public (browser) — provided automatically by Lovable Cloud
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the browser
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
LOVABLE_API_KEY=          # AI gateway: embeddings, reranker, generation, judge
GITHUB_TOKEN=             # optional: raises GitHub API rate limits / private repos
# Optional when swapping providers behind the service abstractions:
GEMINI_API_KEY=
EMBEDDING_API_KEY=
RERANKER_API_KEY=
